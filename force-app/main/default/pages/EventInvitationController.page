<apex:page controller="EventInvitationController"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyHtmlTag="false"
           applyBodyTag="false"
           docType="html-5.0">
<html>
<head>
<meta charset="UTF-8"/>
<title>Event Invitation</title>
</head>
<body style="margin: 0; padding: 25px 0; background-color: #EDEBF3; font-family: 'Segoe UI', Arial, sans-serif;">

    <!-- Main Container -->
    <table align="center" border="0" cellpadding="0" cellspacing="0" width="550" style="max-width: 550px; width: 100%; background-color: #FFFFFF; border-collapse: collapse; margin: 0 auto; box-shadow: 0 10px 30px rgba(80,40,160,0.12);">
        
        <!-- Header -->
        <tr>
            <td style="padding: 20px 24px; background-color: #FFFFFF;">
                <table width="100%" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td align="left" style="vertical-align: middle;">
                            <table border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <!-- 4-Dot Flower CSS Badge -->
                                    <td style="padding-right: 12px; vertical-align: middle;">
                                        <table border="0" cellpadding="2" cellspacing="0" style="background-color: #F4F0FF; padding: 6px; border-radius: 10px;">
                                            <tr>
                                                <td style="width: 8px; height: 8px; background-color: #8B5CF6; border-radius: 50%;"></td>
                                                <td style="width: 8px; height: 8px; background-color: #3B82F6; border-radius: 50%;"></td>
                                            </tr>
                                            <tr>
                                                <td style="width: 8px; height: 8px; background-color: #F59E0B; border-radius: 50%;"></td>
                                                <td style="width: 8px; height: 8px; background-color: #E63980; border-radius: 50%;"></td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="vertical-align: middle;">
                                        <div style="font-size: 18px; font-weight: 800; color: #17152B; line-height: 1.2;">{!companyName}</div>
                                        <div style="font-size: 9px; font-weight: 700; color: #8C8A9E; letter-spacing: 0.8px; margin-top: 2px;">YOUR BRAND, OUR FUTURE</div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td align="right" style="vertical-align: middle;">
                            <span style="color: #E63980; font-weight: 800; font-size: 11px; letter-spacing: 0.6px;">YOU'RE INVITED!</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <!-- 4-Color Gradient Bar -->
        <tr>
            <td style="height: 4px; background: linear-gradient(90deg, #3B82F6 0%, #6C3CE9 35%, #E63980 70%, #F59E0B 100%); line-height: 4px; font-size: 4px;">&nbsp;</td>
        </tr>

        <!-- Body Content -->
        <tr>
            <td style="padding: 24px 28px 15px 28px;">
                
                <!-- Title and Calendar Graphic -->
                <table width="100%" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <td align="left" style="vertical-align: middle;">
                            <div style="color: #6C3CE9; font-weight: 800; font-size: 11px; letter-spacing: 1.5px; margin-bottom: 4px;">INVITATION</div>
                            <div style="font-size: 26px; font-weight: 900; color: #6C3CE9; line-height: 1.2; margin-bottom: 4px;">{!eventName}</div>
                            <div style="font-size: 12px; color: #6B7280; font-weight: 600;">{!eventCategory}</div>
                        </td>
                        <td align="right" width="90" style="vertical-align: middle;">
                            <!-- Calendar Graphic Box -->
                            <table border="0" cellpadding="0" cellspacing="0" style="background-color: #F4F0FF; border: 2px solid #DCD1F8; border-radius: 16px; width: 72px; height: 72px; text-align: center;">
                                <tr>
                                    <td align="center" style="vertical-align: middle;">
                                        <div style="font-size: 28px; line-height: 1;">📅</div>
                                        <div style="display: inline-block; background-color: #3B82F6; color: #ffffff; border-radius: 50%; width: 14px; height: 14px; font-size: 9px; line-height: 14px; font-weight: bold; margin-top: -6px;">✓</div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <div style="height: 2px; width: 60px; background-color: #6C3CE9; margin: 10px 0 16px 0;"></div>

                <!-- Greeting & Text -->
                <div style="font-size: 14px; color: #1F1147; margin-bottom: 8px;">
                    Dear <strong style="color: #6C3CE9;">{!guestName}</strong>,
                </div>
                <div style="font-size: 13px; color: #6B7280; line-height: 1.6; margin-bottom: 20px;">
                    We cordially invite you to join us for our upcoming session! We would be honored to have you with us.
                </div>

                <!-- 4-Row Information Card -->
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border: 1px solid #DDE2EA; border-radius: 8px; overflow: hidden; margin-bottom: 20px;">
                    
                    <!-- DATE -->
                    <tr>
                        <td width="38%" style="background-color: #F5F1FE; padding: 11px 14px; border-bottom: 1px solid #DDE2EA;">
                            <table border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="width: 28px; height: 28px; background-color: #EAE2FF; border-radius: 50%; text-align: center; vertical-align: middle; font-size: 13px;">📅</td>
                                    <td style="padding-left: 10px; color: #8B5CF6; font-weight: 800; font-size: 11px; letter-spacing: 0.5px;">DATE</td>
                                </tr>
                            </table>
                        </td>
                        <td width="62%" align="right" style="background-color: #FFFFFF; padding: 11px 16px; color: #151936; font-weight: 700; font-size: 11px; border-bottom: 1px solid #DDE2EA;">
                            {!eventDate}
                        </td>
                    </tr>

                    <!-- TIME -->
                    <tr>
                        <td style="background-color: #FDF1F5; padding: 11px 14px; border-bottom: 1px solid #DDE2EA;">
                            <table border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="width: 28px; height: 28px; background-color: #FCE1EB; border-radius: 50%; text-align: center; vertical-align: middle; font-size: 13px;">⏰</td>
                                    <td style="padding-left: 10px; color: #E63980; font-weight: 800; font-size: 11px; letter-spacing: 0.5px;">TIME</td>
                                </tr>
                            </table>
                        </td>
                        <td align="right" style="background-color: #FFFFFF; padding: 11px 16px; color: #151936; font-weight: 700; font-size: 11px; border-bottom: 1px solid #DDE2EA;">
                            {!eventTime} IST
                        </td>
                    </tr>

                    <!-- VENUE -->
                    <tr>
                        <td style="background-color: #EFF5FE; padding: 11px 14px; border-bottom: 1px solid #DDE2EA;">
                            <table border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="width: 28px; height: 28px; background-color: #DCE8FF; border-radius: 50%; text-align: center; vertical-align: middle; font-size: 13px;">📍</td>
                                    <td style="padding-left: 10px; color: #3B82F6; font-weight: 800; font-size: 11px; letter-spacing: 0.5px;">VENUE</td>
                                </tr>
                            </table>
                        </td>
                        <td align="right" style="background-color: #FFFFFF; padding: 11px 16px; color: #151936; font-weight: 700; font-size: 11px; border-bottom: 1px solid #DDE2EA;">
                            {!venue}
                        </td>
                    </tr>

                    <!-- RSVP BY -->
                    <tr>
                        <td style="background-color: #F0FBF6; padding: 11px 14px;">
                            <table border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="width: 28px; height: 28px; background-color: #D3F6E6; border-radius: 50%; text-align: center; vertical-align: middle; font-size: 13px;">✉️</td>
                                    <td style="padding-left: 10px; color: #10B981; font-weight: 800; font-size: 11px; letter-spacing: 0.5px;">RSVP BY</td>
                                </tr>
                            </table>
                        </td>
                        <td align="right" style="background-color: #FFFFFF; padding: 11px 16px; color: #151936; font-weight: 700; font-size: 11px;">
                            [RSVP Deadline Date]
                        </td>
                    </tr>
                </table>

                <!-- RSVP Button -->
                <table border="0" cellpadding="0" cellspacing="0" style="margin-bottom: 18px;">
                    <tr>
                        <td align="center" style="background: linear-gradient(90deg, #6C3CE9, #E63980); border-radius: 8px;">
                            <a href="{!rsvpUrl}" target="_blank" style="display: inline-block; padding: 11px 24px; color: #FFFFFF; font-size: 12px; font-weight: 800; text-decoration: none;">
                                📅 &nbsp; RSVP Now
                            </a>
                        </td>
                    </tr>
                </table>

                <!-- Note Callout -->
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color: #F9F8FD; border-left: 3.5px solid #6C3CE9; border-radius: 6px; margin-bottom: 22px;">
                    <tr>
                        <td style="padding: 10px 14px; font-size: 11px; color: #6B7280; line-height: 1.55;">
                            ℹ️ Kindly confirm your attendance by clicking the button above before the RSVP deadline. Seats are limited, and confirmation ensures your spot is reserved.
                        </td>
                    </tr>
                </table>

                <div style="border-top: 1px dashed #E5E2ED; margin-bottom: 16px;"></div>

                <!-- Signoff & Envelope -->
                <table width="100%" border="0" cellpadding="0" cellspacing="0" style="margin-bottom: 10px;">
                    <tr>
                        <td align="left" style="vertical-align: bottom;">
                            <div style="font-size: 12px; color: #6B7280; line-height: 1.6;">
                                Warm regards,<br/>
                                <strong style="color: #1F1147; font-size: 13px;">{!organizationName}</strong>
                            </div>
                        </td>
                        <td align="right" style="vertical-align: bottom;">
                            <div style="font-size: 32px; line-height: 1;">💌</div>
                            <div style="font-size: 10px; color: #8C8A9E; font-weight: 600; font-style: italic; margin-top: 2px;">See you there!</div>
                        </td>
                    </tr>
                </table>

            </td>
        </tr>

        <!-- Footer Strip -->
        <tr>
            <td style="background-color: #F5F3FF; padding: 16px 24px; border-top: 1px solid #EAE6F5;">
                <table width="100%" border="0" cellpadding="0" cellspacing="0">
                    <tr>
                        <!-- Left Details with Circle Badge -->
                        <td width="50%" align="left" style="vertical-align: middle;">
                            <table border="0" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="width: 36px; height: 36px; background-color: #6C3CE9; border-radius: 50%; text-align: center; vertical-align: middle; font-size: 18px; color: #ffffff;">
                                        🏢
                                    </td>
                                    <td style="padding-left: 10px; font-size: 11px; color: #4B5563; line-height: 1.5;">
                                        © 2026 {!organizationName}.<br/>
                                        <span style="color: #6B7280;">{!companyAddress}</span>
                                    </td>
                                </tr>
                            </table>
                        </td>

                        <!-- Right Contact Details -->
                        <td width="50%" align="left" style="padding-left: 18px; border-left: 1.5px solid #AAA4CC; vertical-align: middle;">
                            <div style="font-size: 11px; color: #25213F; font-weight: 600; margin-bottom: 6px;">
                                <span style="display: inline-block; width: 18px; height: 18px; background-color: #EAF3FF; border: 1px solid #3B82F6; border-radius: 50%; text-align: center; line-height: 18px; font-size: 10px; margin-right: 6px;">✉</span>
                                {!supportEmail}
                            </div>
                            <div style="font-size: 11px; color: #25213F; font-weight: 600;">
                                <span style="display: inline-block; width: 18px; height: 18px; background-color: #FFF0F5; border: 1px solid #E63980; border-radius: 50%; text-align: center; line-height: 18px; font-size: 10px; margin-right: 6px;">📞</span>
                                {!supportPhone}
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <!-- Bottom Color Bar -->
        <tr>
            <td style="height: 8px; background: linear-gradient(90deg, #1479E8 0%, #6C3CE9 30%, #E63980 65%, #F59E0B 100%); line-height: 8px; font-size: 8px;">&nbsp;</td>
        </tr>

    </table>

</body>
</html>
</apex:page>