<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Virtual_Event_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Event_Type__c, &quot;Virtual&quot;),
    NOT(ISBLANK( Location_event__c ))
)</errorConditionFormula>
    <errorMessage>Location should not be selected for Virtual events.</errorMessage>
</ValidationRule>
