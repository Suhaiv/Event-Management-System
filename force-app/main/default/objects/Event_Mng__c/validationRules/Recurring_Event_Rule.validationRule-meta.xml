<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Recurring_Event_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>Recurring__c &lt;&gt; NOT(ISPICKVAL(Frequency__c, &quot;&quot;))</errorConditionFormula>
    <errorMessage>Select Frequency only when Recurring is checked.</errorMessage>
</ValidationRule>
