<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Live_Event_Check</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Event_Type__c, &quot;Virtual&quot;),
    Live__c = TRUE
)</errorConditionFormula>
    <errorMessage>Virtual events cannot be marked as Live.</errorMessage>
</ValidationRule>
