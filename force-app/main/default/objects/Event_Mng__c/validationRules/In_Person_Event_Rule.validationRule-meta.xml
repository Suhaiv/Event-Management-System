<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>In_Person_Event_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL( Event_Type__c, &quot;In-Person&quot;),  ISBLANK( Location_event__c  ))</errorConditionFormula>
    <errorMessage>Location is required for In-Person events.</errorMessage>
</ValidationRule>
